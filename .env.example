# ── Scoring backend ───────────────────────────────────────────────────────────
# "watsonx" — IBM watsonx.ai (Llama 3.3 70B Instruct), as used in the
#             IBM watsonx GenAI Challenge 2025. Requires IBM credentials below.
# "ollama"  — local inference via Ollama (default, no credentials needed).
# "openai"  — any OpenAI-compatible API (OpenRouter, Groq, Together, OpenAI).
SCORING_BACKEND=ollama

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
# Make sure Ollama is running:  ollama serve
# Pull a model first:           ollama pull llama3.2
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# ── IBM watsonx.ai (cloud) ────────────────────────────────────────────────────
# Only needed when SCORING_BACKEND=watsonx
IBM_API_KEY=
IBM_PROJECT_ID=
# IBM_WATSONX_URL=https://eu-de.ml.cloud.ibm.com/ml/v1/text/generation?version=2023-05-29
# WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# ── OpenAI-compatible API (cloud) ─────────────────────────────────────────────
# Only needed when SCORING_BACKEND=openai. OPENAI_BASE_URL includes /v1;
# requests go to $OPENAI_BASE_URL/chat/completions.
#
# Llama 3.3 70B (the challenge model) via OpenRouter:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct
# Llama 3.3 70B via Groq (set OPENAI_MAX_CONCURRENCY=1 on the free tier):
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.3-70b-versatile
# Together: https://api.together.xyz/v1, meta-llama/Llama-3.3-70B-Instruct-Turbo
# OpenAI:   https://api.openai.com/v1,    e.g. gpt-4o-mini
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENAI_MAX_CONCURRENCY=4

# ── Section-name translation ──────────────────────────────────────────────────
# Non-English section names are translated to English once per run (cached in
# app/cached_translations/section_names.json).
# "auto"   — the scoring LLM when SCORING_BACKEND is openai or ollama (and
#            configured); otherwise, or if the LLM request fails, Google
#            Translate (default)
# "llm"    — the scoring LLM only (needs SCORING_BACKEND=openai or ollama)
# "google" — Google Translate only (free endpoint, often rate-limited)
# "none"   — no translation; section names stay in the original language
TRANSLATION_BACKEND=auto
